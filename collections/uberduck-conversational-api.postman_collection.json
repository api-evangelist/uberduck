            "description": {
              "content": "Generate a LiveKit token for a real-time AI voice call. Returns the LiveKit server URL, a room name, and a JWT participant token the client uses to join the room. The realtime media transport itself is provided by LiveKit (WebRTC), not by Uberduck's own HTTP API.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "conversational",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
